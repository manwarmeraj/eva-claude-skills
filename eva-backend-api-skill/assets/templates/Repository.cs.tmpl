using EVA.{{Domain}}.Common.Utilities;
using EVA.{{Domain}}.DbEntities.Models;
using EVA.{{Domain}}.Repositories.Common;
using EVA.{{Domain}}.Repositories.Contracts;
using EVA.{{Domain}}.ViewModel.{{Entity}};
using Microsoft.AspNetCore.Http;
using Microsoft.EntityFrameworkCore;
using System.Data;

namespace EVA.{{Domain}}.Repositories.Repositories
{
    public class {{Entity}}Repository : I{{Entity}}Repository
    {
        #region Private Variables

        private readonly IUnitOfWork _unitOfWork;
        private readonly IExecuterSqlProc _sqlExecuterStoreProc;
        private readonly IHttpContextAccessor _httpContextAccessor;
        private readonly int _orgId;

        #endregion Private Variables

        #region Constructor

        public {{Entity}}Repository(
            IUnitOfWork unitOfWork,
            IExecuterSqlProc sqlExecuterStoreProc,
            IHttpContextAccessor httpContextAccessor)
        {
            _unitOfWork = unitOfWork;
            _sqlExecuterStoreProc = sqlExecuterStoreProc;
            _httpContextAccessor = httpContextAccessor;
            _orgId = Convert.ToInt32(_httpContextAccessor.HttpContext.Items[KeyConstant.AppOrgId]);
        }

        #endregion Constructor

        #region Public Methods

        // EF read: AsNoTracking + OrgId filter. An empty list is a valid result -
        // do not treat "no rows" as an error anywhere in this file (EVA-RSP-008).
        public async Task<List<{{Entity}}Model>> GetAll()
        {
            return await _unitOfWork.DataContext.Set<{{Entity}}>()
                .AsNoTracking()
                .Where(x => x.OrgId == _orgId)
                .Select(x => new {{Entity}}Model
                {
                    {{Entity}}Id = x.{{Entity}}Id,
                    Code = x.Code,
                    IsActive = x.IsActive
                })
                .ToListAsync();
        }

        // Returns null when there is no match. The Business layer still reports success.
        public async Task<{{Entity}}Model> Get(long {{entity}}Id)
        {
            return await _unitOfWork.DataContext.Set<{{Entity}}>()
                .AsNoTracking()
                .Where(x => x.{{Entity}}Id == {{entity}}Id && x.OrgId == _orgId)
                .Select(x => new {{Entity}}Model
                {
                    {{Entity}}Id = x.{{Entity}}Id,
                    Code = x.Code,
                    IsActive = x.IsActive
                })
                .FirstOrDefaultAsync();
        }

        // EF write: execution strategy + explicit transaction, await Commit().
        // Never call the synchronous SaveChanges() (EVA-ERR-007).
        public async Task<bool> Add({{Entity}}AddModel model)
        {
            var entity = new {{Entity}}
            {
                Code = model.Code,
                IsActive = true,
                OrgId = _orgId                 // stamp the tenant on write, too
            };

            var strategy = _unitOfWork.DataContext.Database.CreateExecutionStrategy();

            await strategy.ExecuteAsync(async () =>
            {
                using var transaction = await _unitOfWork.DataContext.Database.BeginTransactionAsync();

                await _unitOfWork.DataContext.Set<{{Entity}}>().AddAsync(entity);
                await _unitOfWork.Commit();

                await transaction.CommitAsync();
            });

            return true;
        }

        public async Task<bool> Update({{Entity}}UpdateModel model)
        {
            var entity = await _unitOfWork.DataContext.Set<{{Entity}}>()
                .FirstOrDefaultAsync(x => x.{{Entity}}Id == model.{{Entity}}Id && x.OrgId == _orgId);

            if (entity == null)
                return false;              // plain bool - the Business layer maps this to a code

            entity.Code = model.Code;
            entity.IsActive = model.IsActive;

            var strategy = _unitOfWork.DataContext.Database.CreateExecutionStrategy();

            await strategy.ExecuteAsync(async () =>
            {
                using var transaction = await _unitOfWork.DataContext.Database.BeginTransactionAsync();

                await _unitOfWork.Commit();

                await transaction.CommitAsync();
            });

            return true;
        }

        // Bulk delete: ExecuteDeleteAsync, still OrgId-scoped.
        public async Task<bool> Delete(List<long> {{entity}}Ids)
        {
            int affected = await _unitOfWork.DataContext.Set<{{Entity}}>()
                .Where(x => {{entity}}Ids.Contains(x.{{Entity}}Id) && x.OrgId == _orgId)
                .ExecuteDeleteAsync();

            return affected > 0;
        }

        // Stored proc: name from ProcedureConstants, explicit SqlDbType on every
        // parameter, OrgId always present, output params read defensively.
        // Total count comes back through an out parameter, so hand it to the
        // caller rather than stuffing it into a response envelope here.
        public async Task<(List<{{Entity}}ResultModel> Rows, int TotalCount)> GetPaged(int pageNumber, int pageSize)
        {
            var sqlParams = new List<Parameters>()
            {
                new() { ParameterName = "OrgId",      Value = _orgId,     ParameterType = SqlDbType.BigInt, ParameterDirection = ParameterDirection.Input },
                new() { ParameterName = "PageNumber", Value = pageNumber, ParameterType = SqlDbType.Int,    ParameterDirection = ParameterDirection.Input },
                new() { ParameterName = "PageSize",   Value = pageSize,   ParameterType = SqlDbType.Int,    ParameterDirection = ParameterDirection.Input },
                new() { ParameterName = "TotalCount", Value = 0,          ParameterType = SqlDbType.Int,    ParameterDirection = ParameterDirection.Output }
            };

            var rows = await _sqlExecuterStoreProc
                .ExecuteProcedureAsync<{{Entity}}ResultModel>(ProcedureConstants.sp_Get{{Entity}}List, sqlParams);

            int totalCount = (int)((sqlParams.FirstOrDefault(x => x.ParameterName == "TotalCount")?.Value) ?? 0);

            return (rows, totalCount);
        }

        #endregion Public Methods
    }
}

